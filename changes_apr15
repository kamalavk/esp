// Add these signals in the declarations
reg [2:0] overrun_counter;
reg pull_back;
reg [6:0] tokens_received_from_neighbors; // Tracks how many tokens we received from others
wire overrun_emergency;

assign overrun_emergency = (enable && (token_counter * 100 > max_tokens * 90));

// Add in the OUTPUT_LOGIC block (sequential logic)
always @(posedge clock) begin : OUTPUT_LOGIC
    if (reset == 1'b0) begin
        refresh_count <= 0;
        side_count    <= 0;
        refresh_rate  <= 15;  // Arbitrary value, will be updated by CSR write
        for (i = 0; i < 64; i = i + 1) begin
            LUT[i] <= 8'b0;
        end
        freq_target        <= 0;
        token_counter      <= 0;
        PM_network_shifted <= 0;
        overrun_counter    <= 0;
        pull_back          <= 0;
        tokens_received_from_neighbors <= 0;
    end else begin
        refresh_count      <= refresh_count_next;
        side_count         <= side_count_next;
        refresh_rate       <= refresh_rate_next;
        LUT                <= LUT_next;
        freq_target        <= freq_target_next;
        token_counter      <= tokens_next;
        PM_network_shifted <= PM_network_shifted_next;

        // Overrun counter and pull_back logic
        if (enable && overrun_emergency) begin
            if (overrun_counter < 5)
                overrun_counter <= overrun_counter + 1;
        end else if (enable) begin
            overrun_counter <= 0;
        end

        if (enable) begin
            if (overrun_counter >= 5)
                pull_back <= 1;
            else if (!overrun_emergency)
                pull_back <= 0;
        end
    end
end

// In the COMBO block, right after `tokens_next = token_counter;`
if (pull_back && token_counter > 0) begin
    // Pull back 1 token
    tokens_next = token_counter - 1;
end

// Track received tokens to know how much we owe others
if (packet_in == 1 && packet_in_val[31] == 0 && enable == 1) begin
    // Only count positive contributions from neighbors
    if ($signed(packet_in_val[6:0]) > 0)
        tokens_received_from_neighbors = tokens_received_from_neighbors + packet_in_val[6:0];
end

// Return token as update packet when in pull_back mode and we owe tokens
if (pull_back && packet_out_ready && enable && packet_out_div == 0 && packet_in == 0 && tokens_received_from_neighbors > 0) begin
    // Send packet to neighbor with 1 token to return
    packet_out = 1;
    packet_out_val[31] = 0; // Type: token update
    packet_out_val[6:0] = -1; // Returning 1 token
    packet_out_val[30:7] = 0; // Unused bits cleared
    packet_out_addr = (neighbors_ID & 5'b11111); // Pick first neighbor (W)
    tokens_next = token_counter - 1;
    tokens_received_from_neighbors = tokens_received_from_neighbors - 1; // We returned 1 token
end
